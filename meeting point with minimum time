def dijkstra(source,my_dict):
  priority_q=[]
  for i in range(1,int(x)+1):
    if i==source:
      a=[0,i]
      priority_q.append(a)
    else:
      a=[11111,i]
      priority_q.append(a)
  priority_q.sort()


  distance=[11111]*(int(x))
  predecessor=[0]*int(x)
  distance[source-1]=0

  while priority_q:
    a,b=priority_q.pop(0)
    if b in my_dict:
      for i in my_dict[b]:
        v=i[0]
        if distance[v-1]>distance[b-1]+i[1]:
          distance[v-1]=distance[b-1]+i[1]
          predecessor[v-1]=b
          for i in priority_q:
            if i[1]==v:
              i[0]=distance[v-1]
    priority_q.sort()
  return distance,predecessor
