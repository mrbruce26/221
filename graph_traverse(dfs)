import queue
inp = open("inputmax.txt", "r")
out = open("outputmax.txt", "w")
x,y = inp.readline().split(" ")
r = inp.read().split("\n")

dict={}
for i in range(1,int(x)+1):
    dict[i]=[]
print(dict)
for i in range(int(y)):
    l1 = list(map(int,r[i].split(" ")))
    dict[l1[0]].append(l1[1])

q = []
print(dict)
q.append(1)
visited = []
while not len(q)==0:
    c = q.pop()  # Get the current node
    if c not in visited:
        visited.append(c)
        out.write(str(c) + "\n")

        s = dict[c]
        # Add all unvisited neighbors to the queue
        for j in s:
            if j not in visited:
                q.append(j)
print(visited)
