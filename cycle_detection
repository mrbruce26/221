import queue
inp = open("inputmax.txt", "r")
out = open("outputmax.txt", "w")
x,y = inp.readline().split(" ")
r = inp.read().split("\n")

dict={}
for i in range(1,int(x)+1):
    dict[i]=[]
print(dict)
for i in range(int(y)):
    l1 = list(map(int,r[i].split(" ")))
    dict[l1[0]].append(l1[1])

color = {}
for u in dict.keys():
    color[u] = "w"
def dfs(u,color):
    color[u]="g"
    for v in dict[u]:
        if color[v] == "w":
            is_cycle = dfs(v,color)
            if is_cycle:
                return True
        elif color[v]=="g":
            return True
    color[u] = "b"
    return False
is_cycle = False
for u in dict.keys():
    if color[u]=="w":
        is_cycle = dfs(u,color)
        if is_cycle == True:
            is_cycle = True
            break

out.write(f'Is cyclic {is_cycle}')
